<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSFaceIDUsageDescription</key>
	<string>ApiRelay uses Face ID to confirm your identity before revealing your API key secrets.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Mac App Store / TestFlight 上传必填（错误 90242）。与商店草稿「开发者工具」一致。 -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- 声明了备份文档类型就必须声明是否原地打开。Mac Catalyst 只允许 YES；导入用安全作用域读取，不把明文写回原文件。 -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ApiRelay Encrypted Backup</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apirelay.backup</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.apirelay.backup</string>
			<key>UTTypeDescription</key>
			<string>ApiRelay Encrypted Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apirelaybackup</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
