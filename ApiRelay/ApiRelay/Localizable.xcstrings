    "error.quotaExceeded": {
      "comment": "Error message when free tier key quota is exceeded",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free tier limited to 3 keys. Unlock unlimited keys."
