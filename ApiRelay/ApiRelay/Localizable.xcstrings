    "settings.section.lockTiming": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock & Timeouts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定与超时"
          }
        }
      }
    },
    "settings.section.lockTiming.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Mac, if you're not sure whether a secret has been cleared, the safest move is to copy some other text over it. Also note that Mac clipboard-history tools (Paste, Raycast, Alfred, and the like) capture the content the moment you copy it; this app cannot remove those entries, so you'll need to delete them in those tools yourself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上如果不确定密钥有没有被清掉，随手复制一段别的文字盖过去最保险。另外，Mac 上的剪贴板历史工具（Paste、Raycast、Alfred 等）在你复制的那一刻就已经把内容记进了自己的历史，那份记录本 App 清不掉，需要你自己去那些工具里删。"
          }
        }
      }
    },
    "settings.section.password": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password & Verification"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码与验证"
          }
        }
      }
    },
    "settings.section.password.footer": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal and copy share one verification policy. Turning verification off disables both. Master password is optional and device-local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看与复制共用同一验证方式；关闭验证后二者都不再要求确认。主密码可选，且仅保存在本机。"
          }
        }
      }
    },
