    "vault.sync.openSystemSettings.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app cannot sign you in or switch Apple ID.\nTo see which account is signed in, open System Settings.\niPhone: Settings → [your name] → iCloud → Passwords and Keychain.\nMac: System Settings → Apple ID → iCloud → Passwords and Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 不能登录或切换 Apple ID。\n要看是哪一个账号，去系统设置。\niPhone：设置 → [你的姓名] → iCloud → 密码与钥匙串。\nMac：系统设置 → Apple ID → iCloud → 密码与钥匙串。"
          }
        }
      }
    },
    "vault.sync.secrets.help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key secrets sync through iCloud Keychain with system end-to-end encryption. This app cannot show progress or speed that up. Turn on iCloud Keychain on every device that should see the same keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥明文经 iCloud 钥匙串同步，由系统端到端加密。本 App 看不到进度，也不能催促。每台要共用密钥的设备都需开启 iCloud 钥匙串。"
          }
        }
      }
    },
