    "settings.clipboardClear.label": {
      "comment": "Setting label for clipboard auto-clear duration",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard Auto-Clear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板自动清除"
          }
        }
      }
    },
    "settings.clipboardClear.rowDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you copy a secret, the clipboard is cleared once this much time has passed. On iPhone and iPad the system does this for you, so it still happens even if you close the app. On Mac the system offers no such guarantee, so the app has to time it itself: it clears on schedule while the app is running, and also clears on a normal quit (⌘Q) — but not if the app is force-quit or crashes, in which case the secret stays on the clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制密钥后，过了这个时长就清空剪贴板。iPhone、iPad 上这件事交给系统做，你就算关掉 App 也会照清。Mac 上系统不提供这个能力，只能由 App 自己计时；App 开着时会按时清除，正常退出（⌘Q）时也会顺手清掉，但强制退出或 App 崩溃时不会清，密钥会一直留在剪贴板里。"
          }
        }
      }
    },
    "settings.clipboardLocalOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable Universal Clipboard"
