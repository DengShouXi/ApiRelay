    "vault.recentlyDeleted.empty.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is where deleted keys, accounts, and consumers go.\n\n1. On the home list, tap Delete and authenticate.\n2. They appear here for 30 days.\n3. You can Restore or Delete Forever.\n\nItems deleted before this feature won’t show up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里存放你删掉的密钥、账号、使用方。\n\n1. 在主列表点「删除」，并通过本机验证。\n2. 删除后会出现在这里，保留 30 天。\n3. 可「恢复」或「永久删除」。\n\n本功能上线前已删掉的内容不会出现在这里。"
          }
        }
      }
    },
    "vault.recentlyDeleted.empty.how" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To put something here: delete a key (By Platform), delete an account, or delete a consumer — then authenticate when prompted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要放进回收站：在「按平台」删密钥、删账号，或删使用方，并完成系统验证。取消验证则不会移入。"
          }
        }
      }
    },
    "vault.recentlyDeleted.hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept for 30 days. Restore brings them back; Delete Forever cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认保留 30 天。「恢复」可找回；「永久删除」不可撤销。"
          }
        }
      }
    },
    "vault.recentlyDeleted.loadFailed" : {
      "extractionState" : "stale",
