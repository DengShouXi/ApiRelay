    "vault.sync.status.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and accounts sync through iCloud. The last-success time is only for this device. Key secrets sync through iCloud Keychain. Sync Now cannot speed that up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称和账号经 iCloud 同步。这里的上次时间只记录这台设备交名称成功的时刻。密钥明文经 iCloud 钥匙串同步，立即同步催不了。"
          }
        }
      }
    },
