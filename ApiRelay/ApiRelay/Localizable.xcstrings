      }
    },
    "error.secretMissingOnDevice": {
      "comment": "Error message when key metadata exists but Keychain has no corresponding secret",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secret not available on this device"
