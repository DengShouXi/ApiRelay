    },
    "error.backupVersionUnsupported %lld %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup version %lld is unsupported (supported: %lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的备份版本 %lld（当前支持 %lld）。"
          }
        }
      }
    },
    "error.biometryUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrics unavailable. Choose another reveal policy in Settings, or use device passcode policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生物识别不可用。请在设置中改用「本机密码」档，或检查系统触控 ID / 面容 ID。"
          }
        }
      }
    },
    "error.capabilityUnsupported %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Platform %@ does not support this capability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平台 %@ 不支持该能力。"
          }
        }
      }
    },
    "error.createdUpstreamButLocalSaveFailed %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created on %@ but failed to save locally. The upstream key was not rolled back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 %@ 创建，但本地保存失败；上游密钥未自动回滚。"
          }
        }
      }
    },
