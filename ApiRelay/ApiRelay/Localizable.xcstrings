    "settings.eraseAll.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes keys, preferences, and local data on this device. Purchases are kept. Synced devices may also clear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将清除本机密钥、偏好等用户数据；不吊销购买。若已同步，其他设备上的同步数据也可能被清。"
          }
        }
      }
    },
