      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消验证。"
          }
        }
      }
    },
    "error.authenticationFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Try again with your device password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证失败，请使用本机密码重试。"
          }
        }
      }
    },
    "error.backupPassphraseIncorrect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup passphrase is incorrect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份口令不正确。"
          }
        }
